TRANSCRIBE_API_KEY=
TRANSCRIBE_URL=https://transcribe.raifen.ai

N8N_MARKDOWN_WEBHOOK=https://n8n.raifen.ai/webhook/markdown-raifen

ADMIN_REVIEW_EMAIL=tomas@raifen.ai

# Aviso por correo cuando un participante finaliza su formulario -- opcional, si se deja
# vacio simplemente no se manda el aviso (no rompe nada). Con Gmail hace falta un
# "App Password" (no la contraseña normal de la cuenta, requiere 2FA activo).
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_FROM=Raifen Discovery <no-reply@raifen.ai>

BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=changeme

# URL publica de ESTA instancia (una por cliente). En Coolify tiene que ser EXACTAMENTE
# el dominio configurado para el servicio -- si no coinciden, los links que arma la app
# apuntan a un host sin certificado SSL valido y el navegador muestra error de conexion
# insegura. Ej. para la instancia de testing: https://discovery.raifen.ai
PUBLIC_BASE_URL=http://127.0.0.1:8020

BRAND_NAME=Raifen

DB_PATH=data/discovery.db
UPLOADS_DIR=data/adjuntos
